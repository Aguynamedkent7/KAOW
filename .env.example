# KAOW Daemon Configuration
# Copy to .env and fill in values

# Server
KAOW_HOST=0.0.0.0
KAOW_PORT=8765

# Authentication
KAOW_AUTH_TOKEN=change-me-to-a-secure-token

# AI CLI Adapter (claude | opendevin)
KAOW_CLI_ADAPTER=claude
KAOW_CLI_PATH=claude

# Virtual Display
KAOW_DISPLAY_RESOLUTION=1920x1080
KAOW_SCREENSHOT_INTERVAL=5

# Logging
KAOW_LOG_LEVEL=INFO

# Relay mode: local | cloud | both
KAOW_RELAY_MODE=local

# Supabase (required when relay_mode is cloud or both)
KAOW_SUPABASE_URL=https://your-project.supabase.co
KAOW_SUPABASE_SERVICE_KEY=your-service-role-key
KAOW_SUPABASE_ANON_KEY=your-anon-key

# Device identity (set after QR pairing)
KAOW_DEVICE_NAME=My PC
KAOW_DEVICE_USER_ID=
