# KAOW Daemon Configuration
# Copy to .env and fill in values

# Server
KAOW_HOST=0.0.0.0
KAOW_PORT=8765

# Authentication
KAOW_AUTH_TOKEN=change-me-to-a-secure-token

# Display capture: auto | virtual | real
# auto  = real display first, Xvfb virtual fallback (default)
# virtual = Xvfb only (headless mode)
# real  = real display only, error if none found
KAOW_CAPTURE_MODE=real

# AI CLI Adapter (claude | opendevin | opencode)
KAOW_CLI_ADAPTER=opencode
KAOW_CLI_PATH=opencode

# Virtual Display
KAOW_DISPLAY_RESOLUTION=1920x1080
KAOW_SCREENSHOT_INTERVAL=5

# Logging
KAOW_LOG_LEVEL=INFO

# Local persistence (chat transcript lives on this PC)
KAOW_DATA_DIR=~/.kaow

# Pairing: `uv run kaow-pair` prints a QR code with the WS URL + auth token
# KAOW_AUTH_TOKEN above is the token the phone uses to connect
